{
  "name": "kafka-driver-qualification",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "qualify:real-kafka": "npm run test:qualification-policy && smoque run smoke/ --ci",
    "qualify:real-kafka-functional": "npm run test:qualification-policy && smoque run smoke/ --tag real-kafka-functional --ci",
    "measure:real-kafka": "smoque run smoke/ --tag real-kafka-performance --ci",
    "smoke:list": "smoque list smoke/",
    "smoke:real-kafka": "smoque run smoke/ --tag real-kafka --ci",
    "smoke:real-kafka-movement": "smoque run smoke/ --tag real-kafka-movement --ci",
    "smoke:real-kafka-multi-broker": "smoque run smoke/ --tag real-kafka-multi-broker --ci",
    "smoke:real-kafka-sasl": "smoque run smoke/ --tag real-kafka-sasl --ci",
    "smoke:real-kafka-secure-multi-broker": "smoque run smoke/ --tag real-kafka-secure-multi-broker --ci",
    "smoke:real-kafka-security": "smoque run smoke/ --tag real-kafka-security --ci",
    "smoke:real-kafka-tls": "smoque run smoke/ --tag real-kafka-tls --ci",
    "smoke:real-kafka-reconnect": "smoque run smoke/ --tag real-kafka-reconnect --ci",
    "test:qualification-policy": "node --test smoke/*.test.mjs"
  },
  "devDependencies": {
    "smoque": "0.1.0"
  }
}
