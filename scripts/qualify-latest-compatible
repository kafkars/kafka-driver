#!/usr/bin/env bash
set -euo pipefail

qualification_root=target/package-qualification
version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml)
if [[ -z "$version" ]]; then
  echo "workspace release version is missing" >&2
  exit 1
fi
core_root="$qualification_root/kafka-driver-core-$version"
transport_root="$qualification_root/kafka-driver-transport-$version"
driver_root="$qualification_root/kafka-driver-$version"

for package_root in "$core_root" "$transport_root" "$driver_root"; do
  if [[ ! -f "$package_root/Cargo.toml" ]]; then
    echo "run scripts/qualify-packages before latest-compatible qualification" >&2
    exit 1
  fi
done

latest_cargo_home=$(mktemp -d "${TMPDIR:-/tmp}/kafka-driver-cargo-home.XXXXXX")
trap 'rm -rf -- "$latest_cargo_home"' EXIT
export CARGO_HOME="$latest_cargo_home"
unset CARGO_NET_OFFLINE

core_patch="patch.crates-io.kafka-driver-core.path='$core_root'"
transport_patch="patch.crates-io.kafka-driver-transport.path='$transport_root'"

rm -f \
  "$core_root/Cargo.lock" \
  "$transport_root/Cargo.lock" \
  "$driver_root/Cargo.lock"

cargo generate-lockfile \
  --manifest-path "$core_root/Cargo.toml"
cargo check \
  --locked \
  --all-features \
  --manifest-path "$core_root/Cargo.toml"

cargo generate-lockfile \
  --config "$core_patch" \
  --manifest-path "$transport_root/Cargo.toml"
cargo check \
  --locked \
  --all-features \
  --config "$core_patch" \
  --manifest-path "$transport_root/Cargo.toml"

cargo generate-lockfile \
  --config "$core_patch" \
  --config "$transport_patch" \
  --manifest-path "$driver_root/Cargo.toml"
cargo check \
  --locked \
  --all-features \
  --config "$core_patch" \
  --config "$transport_patch" \
  --manifest-path "$driver_root/Cargo.toml"

package_versions() {
  local package_name=$1
  awk -v wanted="$package_name" '
    /^\[\[package\]\]$/ { name = ""; next }
    /^name = / {
      name = $0
      sub(/^name = "/, "", name)
      sub(/"$/, "", name)
      next
    }
    /^version = / && name == wanted {
      version = $0
      sub(/^version = "/, "", version)
      sub(/"$/, "", version)
      print version
    }
  ' "$driver_root/Cargo.lock" | sort -u
}

for package in kafka-wire kafka-wire-core; do
  versions=$(package_versions "$package")
  count=$(printf '%s\n' "$versions" | sed '/^$/d' | wc -l | tr -d ' ')
  if [[ "$count" != 1 ]]; then
    echo "$package resolved to $count versions: $versions" >&2
    exit 1
  fi
  printf '%s resolved to %s\n' "$package" "$versions"
done
